{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=jobprocessor.db"
  },
  "AllowedOrigins": [ "http://localhost:5173" ],
  "RetrySettings": {
    "MaxRetries": 5,
    "InitialDelaySeconds": 2,
    "BackoffMultiplier": 2,
    "MaxDelaySeconds": 60,
    "UseJitter": false
  },
  "WorkerSettings": {
    "WorkerCount": 3,
    "RetryScanIntervalSeconds": 1
  }
}
